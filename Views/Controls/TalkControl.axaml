<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenTalkIt.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OpenTalkIt.Views.Controls.TalkControl"
             x:DataType="vm:TalkControlViewModel">

    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock>Type your text here!</TextBlock>
        <TextBox Text="{Binding Text}"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="Stop"
                    Command="{Binding StopCommand}"/>
            <Button Content="Talk It!"
                    Command="{Binding TalkCommand}"/>

        </StackPanel>
    </StackPanel>
    
</UserControl>
