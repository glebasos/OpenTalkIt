<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenTalkIt.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:OpenTalkIt.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
             x:Class="OpenTalkIt.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             Background="#1D0E3C">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- Phone layout: MainView.axaml.cs adds "narrow" below 600 px, which the
         controls below also key on. Adaptive properties live in styles, not
         attributes, because a local value would win over the narrow setter. -->
    <UserControl.Styles>
        <Style Selector="Border#Frame"><Setter Property="Margin" Value="14"/></Style>
        <Style Selector="Border#InnerFrame"><Setter Property="Margin" Value="6"/></Style>
        <Style Selector="Grid#Panels"><Setter Property="Margin" Value="10"/></Style>
        <Style Selector=".narrow Border#Frame"><Setter Property="Margin" Value="4"/></Style>
        <Style Selector=".narrow Border#InnerFrame"><Setter Property="Margin" Value="2"/></Style>
        <Style Selector=".narrow Grid#Panels"><Setter Property="Margin" Value="6"/></Style>
    </UserControl.Styles>

    <Grid x:Name="Root">
        <!-- Animated cloud shader background -->
        <controls:CloudShaderControl x:Name="Clouds"/>

        <!-- Purple chrome frame -->
        <Border x:Name="Frame"
                CornerRadius="22"
                BorderThickness="3"
                BorderBrush="{StaticResource Y2kHighlight}"
                Background="{StaticResource Y2kChrome}"
                BoxShadow="0 6 24 0 #80000000">
            <Border x:Name="InnerFrame"
                    CornerRadius="18"
                    BorderThickness="2"
                    BorderBrush="#2A134E"
                    Background="#331956">
                <Grid x:Name="Panels" RowDefinitions="Auto,Auto,*">

                    <Border Grid.Row="0"
                            CornerRadius="14"
                            BorderThickness="2"
                            BorderBrush="#8562C5"
                            Background="{StaticResource Y2kPanel}"
                            Padding="8"
                            Margin="0,0,0,8">
                        <controls:PersonalityControl DataContext="{Binding PersonalityVM}"/>
                    </Border>

                    <Border Grid.Row="1"
                            CornerRadius="14"
                            BorderThickness="2"
                            BorderBrush="#8562C5"
                            Background="{StaticResource Y2kPanel}"
                            Padding="6"
                            Margin="0,0,0,8">
                        <controls:ParameterControl DataContext="{Binding ParameterVM}"/>
                    </Border>

                    <Border Grid.Row="2"
                            CornerRadius="14"
                            BorderThickness="2"
                            BorderBrush="#8562C5"
                            Background="{StaticResource Y2kPanel}"
                            Padding="6">
                        <controls:TalkControl DataContext="{Binding TalkVM}"/>
                    </Border>

                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
