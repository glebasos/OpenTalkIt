<Project Sdk="Microsoft.NET.Sdk">
    <!-- Whether this build/publish targets Windows. Honors an explicit
         RuntimeIdentifier first, so cross-publishing with `-r win-x64` from
         macOS/Linux still pulls in the win-x86 TiSpeech.Host toolchain below;
         falls back to the build OS for a plain `dotnet build`/`dotnet run`
         with no RID. Everything Windows-only (the app manifest, the x86
         SoftVoice host copy/publish targets) is gated on this. -->
    <PropertyGroup>
        <_TargetsWindows Condition="'$(RuntimeIdentifier)' != '' AND $(RuntimeIdentifier.StartsWith('win'))">true</_TargetsWindows>
        <_TargetsWindows Condition="'$(RuntimeIdentifier)' == '' AND '$(OS)' == 'Windows_NT'">true</_TargetsWindows>
        <_TargetsWindows Condition="'$(_TargetsWindows)' == ''">false</_TargetsWindows>
    </PropertyGroup>

    <PropertyGroup>
        <IncludeLegacySpeechHost Condition="'$(IncludeLegacySpeechHost)' == ''">false</IncludeLegacySpeechHost>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="OpenTalkIt.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- Plain net10.0 so this project can build/run on macOS and Linux.
             TiSpeech.Client (the only project reference) is also net10.0 now;
             the TiSpeech.Host/native-DLL path stays Windows/x86-only and is
             gated below via _TargetsWindows rather than via the TFM. -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest Condition="'$(_TargetsWindows)' == 'true'">app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets\opentalkit.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- Release builds should not carry SkiaSharp/HarfBuzz native PDBs or our
         own symbols — they bloat the publish folder by ~100 MB and are not
         needed by end users. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
        <CopyDocumentationFilesFromPackages>false</CopyDocumentationFilesFromPackages>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <!-- tests/ is a separate test project (OpenTalkIt.Tests) that references
         this project; without this exclusion the SDK's default **/*.cs glob
         would also try to compile its xUnit test sources (and its own
         bin/obj) directly into this WinExe app. -->
    <ItemGroup>
        <Compile Remove="tests\**\*.cs"/>
        <None Remove="tests\**\*.cs"/>
        <AvaloniaResource Remove="tests\**"/>
    </ItemGroup>

    <!-- Native 32-bit SoftVoice DLLs that TiSpeech.Host loads at runtime via
         SetDllDirectoryW(BaseDirectory/x86). They must sit next to
         TiSpeech.Host.exe in the x86\ folder for both local runs and publish.
         Copied explicitly because None/Link with a subdirectory doesn't
         survive the publish copy pass reliably. -->
    <ItemGroup>
        <_NativeTiDlls Include="DLLs\*.DLL" Condition="'$(_TargetsWindows)' == 'true' AND '$(IncludeLegacySpeechHost)' == 'true' AND Exists('DLLs')" />
    </ItemGroup>

    <ItemGroup>
        <!-- 12.0.1 fixes the macOS save-picker callback crash (AvaloniaUI/Avalonia#21104). -->
        <PackageReference Include="Avalonia" Version="12.0.1"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.0.1"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.0">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1"/>
        <PackageReference Include="NAudio" Version="2.2.1"/>
        <!-- Avalonia.Desktop pulls in Avalonia.FreeDesktop (Linux D-Bus
             clipboard/tray support) which transitively resolved
             Tmds.DBus.Protocol 0.90.3 — vulnerable per GHSA-xrw6-gwf8-vvr9
             (fixed in 0.92.0+). Pin it directly so NuGet resolves a patched
             version regardless of what Avalonia's own dependency range asks
             for. -->
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1"/>
    </ItemGroup>

    <ItemGroup>
        <!-- TiSpeech.Client lives one level up, as a sibling of this repo's
             OpenTalkIt/ folder (see README "Project Structure"). -->
        <ProjectReference Include="..\TiSpeech.Client\TiSpeech.Client.csproj" />
    </ItemGroup>

    <!-- Drop the native SoftVoice DLLs into $(OutDir)x86\ before the x86 host
         gets copied, so dev-time runs can find TIBASE32.DLL. Windows/x86-only:
         see _TargetsWindows above. -->
    <Target Name="CopyNativeTiDllsToOutput" BeforeTargets="CopyTiSpeechHost"
            Condition="'$(_TargetsWindows)' == 'true' AND '$(IncludeLegacySpeechHost)' == 'true' AND '@(_NativeTiDlls)' != ''">
        <Copy SourceFiles="@(_NativeTiDlls)"
              DestinationFolder="$(OutDir)x86\"
              SkipUnchangedFiles="true" />
    </Target>

    <!-- Build TiSpeech.Host (x86) and copy its output to x86\ next to this exe.
         The native DLLs (TIBASE32.DLL etc.) also belong in that x86\ folder.
         RuntimeIdentifier is cleared so an outer `dotnet publish -r win-x64` does
         not leak a 64-bit RID into the x86 host project (NETSDK1032).
         Windows/x86-only: TiSpeech.Host wraps a 32-bit native Win32 DLL and
         cannot build or run on macOS/Linux, so this whole target is skipped
         unless _TargetsWindows is true (see property above). -->
    <Target Name="CopyTiSpeechHost" AfterTargets="Build"
            Condition="'$(_TargetsWindows)' == 'true' AND '$(IncludeLegacySpeechHost)' == 'true'">
        <MSBuild Projects="..\TiSpeech.Host\TiSpeech.Host.csproj"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=;SelfContained=false;PublishReadyToRun=false;PublishSingleFile=false;PublishTrimmed=false;PublishAot=false"
                 Targets="Restore;Build"
                 BuildInParallel="false" />
        <ItemGroup>
            <_HostFiles Include="..\TiSpeech.Host\bin\$(Configuration)\net10.0-windows\**\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(_HostFiles)"
              DestinationFolder="$(OutDir)x86\%(RecursiveDir)"
              SkipUnchangedFiles="true" />
    </Target>

    <!-- Publish TiSpeech.Host as a SELF-CONTAINED win-x86 app and drop its
         output into $(PublishDir)x86\. This is the critical difference from the
         dev-time CopyTiSpeechHost target: end-user machines are not guaranteed
         to have the 32-bit .NET runtime installed, so the host process dies on
         launch if we only ship the framework-dependent build. Process.Start
         still succeeds, but the host exits immediately and the Open() call
         times out — the user hears nothing with no visible error.

         IsPublishable=true overrides the csproj setting (which is there so that
         solution-level publish skips the host). We also force a clean RID so an
         outer `publish -r win-x64` doesn't leak into this x86 build.
         Windows/x86-only: gated on _TargetsWindows, which also honors an
         explicit `-r win-x64`/`-r win-x86` cross-publish RID even when the
         build machine itself is macOS/Linux. -->
    <Target Name="PublishTiSpeechHostSelfContained" AfterTargets="Publish"
            Condition="'$(_TargetsWindows)' == 'true' AND '$(IncludeLegacySpeechHost)' == 'true'">
        <MSBuild Projects="..\TiSpeech.Host\TiSpeech.Host.csproj"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x86;SelfContained=true;IsPublishable=true;PublishSingleFile=false;PublishTrimmed=false;PublishAot=false;PublishReadyToRun=false;PublishDir=bin\$(Configuration)\net10.0-windows\win-x86\publish\"
                 Targets="Restore;Publish"
                 BuildInParallel="false" />
        <ItemGroup>
            <_HostPublishFiles Include="..\TiSpeech.Host\bin\$(Configuration)\net10.0-windows\win-x86\publish\**\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(_HostPublishFiles)"
              DestinationFolder="$(PublishDir)x86\%(RecursiveDir)"
              SkipUnchangedFiles="true" />
    </Target>

    <!-- Same DLL copy for publish, next to TiSpeech.Host.exe in x86\. Opt-in
         (-p:BundleSoftVoiceDlls=true) for private builds only: the DLLs belong
         to SoftVoice, Inc. and must not be redistributed, so release zips leave
         x86\ for users to fill from their own TalkIt install. The native
         engine finds them there too (TiSpeechNative.DllSearchDirectories).
         Windows/x86-only. -->
    <Target Name="CopyNativeTiDllsToPublish" AfterTargets="PublishTiSpeechHostSelfContained"
            Condition="'$(_TargetsWindows)' == 'true' AND '$(IncludeLegacySpeechHost)' == 'true' AND '@(_NativeTiDlls)' != '' AND '$(BundleSoftVoiceDlls)' == 'true'">
        <Copy SourceFiles="@(_NativeTiDlls)"
              DestinationFolder="$(PublishDir)x86\"
              SkipUnchangedFiles="true" />
    </Target>

    <!-- Strip all .pdb files from the publish output. SkiaSharp/HarfBuzz native
         PDBs are delivered via runtimes/win-x64/native/ and are NOT filtered by
         CopyDebugSymbolFilesFromPackages. Also drops project-reference PDBs that
         slip through when the referenced projects don't opt out themselves. -->
    <Target Name="StripPublishPdbs" AfterTargets="Publish">
        <ItemGroup>
            <_PublishPdbs Include="$(PublishDir)**\*.pdb" />
        </ItemGroup>
        <Delete Files="@(_PublishPdbs)" />
    </Target>

</Project>
